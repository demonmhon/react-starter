{
  "name": "react-starter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "lint:fix": "eslint ./src --fix",
    "prepare": "husky install",
    "preview": "vite preview",
    "prettier": "prettier --check \"src/**/*.(js|jsx|ts|tsx|css)\"",
    "format": "prettier --check \"src/**/*.(js|jsx|ts|tsx|css)\" --write"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "axios": "^1.20.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "i18next-browser-languagedetector": "^8.2.1",
    "i18next-http-backend": "^3.0.6",
    "js-cookie": "^3.0.8",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.9",
    "pretty-quick": "^4.2.2",
    "react-i18next": "^16.6.6",
    "react-router-dom": "^7.18.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,css,md}": [
      "npx pretty-quick --staged"
    ]
  }
}
